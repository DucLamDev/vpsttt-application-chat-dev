# Production app
APP_ENV=production
APP_NAME=webtui-chat
APP_URL=https://chat.vpsttt.com
APP_VERSION=production
SERVICE_NAME=api
LOG_LEVEL=info
LOG_FORMAT=json

# HTTP server inside container
API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=8080
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s
API_SHUTDOWN_TIMEOUT=10s

# Reverse proxy, CORS, hardening, metrics
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
CORS_ALLOWED_ORIGINS=https://chat.vpsttt.com,http://tauri.localhost,https://tauri.localhost,tauri://localhost
SECURE_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Domains and TLS
API_DOMAIN=chat.vpsttt.com
FRONTEND_DOMAIN=chat.vpsttt.com
ADMIN_BASE_PATH=/admin
LETSENCRYPT_EMAIL=admin@vpsttt.com
AUTO_INIT_TLS=true

# Browser runtime on the same public origin
NEXT_PUBLIC_API_BASE_URL=https://chat.vpsttt.com
NEXT_PUBLIC_WS_BASE_URL=wss://chat.vpsttt.com/ws
# Cùng Web OAuth client ID dùng để xác minh Google ID token ở backend.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RTC_ICE_SERVERS=stun:stun.l.google.com:19302

# Images. GitHub Actions exports these values during deploy.
WEBTUI_API_IMAGE=ghcr.io/owner/repo/api:latest
WEBTUI_WORKER_IMAGE=ghcr.io/owner/repo/worker:latest
WEBTUI_WEB_IMAGE=ghcr.io/owner/repo/web:latest
WEBTUI_ADMIN_IMAGE=ghcr.io/owner/repo/admin:latest

# Desktop app release/update
DESKTOP_MIN_VERSION=0.1.0
DESKTOP_RECOMMENDED_VERSION=0.1.2
DESKTOP_UPDATE_URL=https://chat.vpsttt.com/downloads/files/desktop/stable/windows/WebTui-Chat-latest-setup.exe
DESKTOP_RELEASE_MANIFEST_DIR=/var/lib/webtui/desktop-releases
DOWNLOAD_MANIFEST_DIR=/var/lib/webtui/download-manifests

# Worker
WORKER_CONCURRENCY=4
MODULE_RUNNER_SCRIPT_ALLOWLIST=

# Backup
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_TIMEOUT=10m

# PostgreSQL inside VPS
DATABASE_ENABLED=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=webtui_chat
POSTGRES_USER=webtui
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgres://webtui:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/webtui_chat?sslmode=disable

# Redis inside VPS
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# RabbitMQ / CloudAMQP
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqps://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST/CHANGE_ME_VHOST

# MinIO / S3
STORAGE_PROVIDER=minio
LOCAL_STORAGE_PATH=data/storage
MINIO_BUCKET=webtui-chat
S3_ENDPOINT=https://CHANGE_ME_MINIO_ENDPOINT
S3_REGION=vn-1
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY

# JWT and webhook secrets
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET
WEBHOOK_SIGNING_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET

# ZEGOCLOUD call/video call
ZEGO_APP_ID=0
ZEGO_APP_SIGN=
ZEGO_SERVER_SECRET=
ZEGO_TOKEN_TTL=24h
ZEGO_CALL_RING_TIMEOUT=30s

# Firebase Cloud Messaging (backend/worker)
# Prefer the base64 value in Docker. Never commit the service-account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternative for non-Docker deployments:
FIREBASE_SERVICE_ACCOUNT_FILE=

# GitHub Actions variables
# DEPLOY_PATH=/opt/webtui-chat
# API_HEALTH_URL=https://chat.vpsttt.com/ready

# GitHub Actions secrets
# DEPLOY_HOST=160.191.55.144
# DEPLOY_PORT=22
# DEPLOY_USER=root
# DEPLOY_PASSWORD=
# DEPLOY_SSH_KEY=<private key content>
# GHCR_USERNAME=<github username>
# GHCR_TOKEN=<classic PAT with read:packages for private GHCR packages>
