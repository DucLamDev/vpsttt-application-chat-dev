{
	email {$LETSENCRYPT_EMAIL}
	admin off
}

{$FRONTEND_DOMAIN} {
	encode zstd gzip

	@websocket path /ws /api/v1/ws
	handle @websocket {
		rewrite * /api/v1/ws
		reverse_proxy api:8080
	}

	@api path /.well-known/vpsttt-chat /api /api/* /health /ready /version /metrics /desktop/releases* /mobile/releases* /downloads/manifest*
	handle @api {
		reverse_proxy api:8080
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy admin:3001
	}

	@portal path /portal /portal/*
	handle @portal {
		reverse_proxy portal:3002
	}

	handle_path /downloads/files/* {
		root * /srv/downloads
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
