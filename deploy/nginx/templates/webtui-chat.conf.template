server {
    listen 80;
    server_name ${FRONTEND_DOMAIN} ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${FRONTEND_DOMAIN} ${API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:WEBTUI_SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 50m;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    set $frontend_upstream ${FRONTEND_UPSTREAM};
    set $admin_upstream ${ADMIN_UPSTREAM};
    set $portal_upstream ${PORTAL_UPSTREAM};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;

    location = /.well-known/vpsttt-chat {
        proxy_pass http://$api_upstream/.well-known/vpsttt-chat$is_args$args;
        proxy_http_version 1.1;
    }

    location = /api {
        proxy_pass http://$api_upstream/api$is_args$args;
        proxy_http_version 1.1;
    }

    location = /ws {
        proxy_pass http://$api_upstream/api/v1/ws$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /api/v1/ws {
        proxy_pass http://$api_upstream/api/v1/ws$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
    }

    location ~ ^/(desktop/releases|mobile/releases|downloads/manifest)/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
    }

    location /downloads/files/ {
        alias /var/www/downloads/;
        add_header Cache-Control "public, max-age=300";
        types {
            application/vnd.android.package-archive apk;
            application/octet-stream exe msi dmg AppImage;
            application/vnd.debian.binary-package deb;
            application/json json;
            text/plain sha256;
            application/zip zip;
        }
        default_type application/octet-stream;
    }

    location = /download {
        return 301 /download/;
    }

    location = /download/ {
        alias /var/www/downloads/index.html;
        add_header Cache-Control "public, max-age=300";
    }

    location /download/ {
        rewrite ^/download/(.*)$ /$1 break;
        root /var/www/downloads;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "public, max-age=300";
    }

    location ~ ^/(health|ready|version|metrics)$ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
    }

    location = /admin {
        proxy_pass http://$admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ^~ /admin/ {
        proxy_pass http://$admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /portal {
        proxy_pass http://$portal_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ^~ /portal/ {
        proxy_pass http://$portal_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
