{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal desktop capabilities for the WebTui Chat shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    "deep-link:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    "updater:default",
    "http:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" }
      ]
    }
  ]
}
